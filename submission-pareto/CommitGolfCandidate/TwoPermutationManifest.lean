theorem check_decodes :
    (checkWords.all fun w => (CommitGolf.Riscv.decodeInstruction w).isSome) = true := by decide

theorem linked_leaf_kernel : ∀ slot : Fin 16,
    ((commitWords.drop (16 + 15 * slot.val)).take 15) = leafWords slot := by decide

def decodeBase (word : BitVec 32) : Option RiscvZkvm.Rv64.Instr :=
  (CommitGolf.Riscv.decodeInstruction word).bind fun
    | .base instruction => some instruction
    | _ => none

theorem decoded_leaf_kernel : ∀ slot : Fin 16,
    (((commitWords.drop (16 + 15 * slot.val)).take 15).map decodeBase) =
      (leafInstructions slot).map some := by decide

end TwoPermutationPrototype.RV64.Manifest
